<Project>

  <!--
    Each package shows its own readme on nuget.org: docs/nuget/<PackageId>.md.
    The repository's README.md is for GitHub. This lives in .targets, not .props, because
    PackageId is only known after each project file has been read.
  -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false'">
    <PackageReadmeFile>$(PackageId).md</PackageReadmeFile>
    <!-- An embedded icon (128x128 PNG), as nuget.org expects of packages under a reserved ID prefix. -->
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)docs/nuget/$(PackageId).md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/nuget/icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
