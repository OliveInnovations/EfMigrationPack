<Project>

  <!-- Release numbering: see RELEASING.md. -->
  <PropertyGroup>
    <!-- Minor.patch shared by every package: EfMigrationPack {EfMajor}.{PackRelease}, tools 1.{PackRelease}. -->
    <PackRelease Condition="'$(PackRelease)' == ''">0.0</PackRelease>
    <VersionSuffix Condition="'$(IsRelease)' != 'true'">dev</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata. Repository: github.com/OliveInnovations/EfMigrationPack. -->
  <PropertyGroup>
    <Authors>Paul Oliver</Authors>
    <Copyright>Copyright (c) 2026 Paul Oliver</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/OliveInnovations/EfMigrationPack</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OliveInnovations/EfMigrationPack.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The words people search for, including "squash", which is what most of them call this. -->
    <PackageTags>efcore;entity-framework-core;ef-core;migrations;database-migrations;squash-migrations;consolidate-migrations;build-performance;build-time</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Each EF Core build of the runtime gets its own obj/ and bin/ so the builds don't overwrite each other. -->
  <PropertyGroup Condition="'$(EfMajor)' != ''">
    <BaseIntermediateOutputPath>obj\ef$(EfMajor)\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\ef$(EfMajor)\</BaseOutputPath>
  </PropertyGroup>

  <!-- The nuget.org readme for each package is wired up in Directory.Build.targets. -->

</Project>
