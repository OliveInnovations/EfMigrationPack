<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EfMigrationPack.Tools: Package Manager Console commands Compress-Migrations and Expand-Migrations,
    the counterpart of Microsoft.EntityFrameworkCore.Tools. Contains no library: tools/ holds init.ps1,
    the PowerShell module and the CLI binaries, which build.ps1 publishes to artifacts/cli-bin first.
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>

    <PackageId>EfMigrationPack.Tools</PackageId>
    <VersionPrefix>1.$(PackRelease)</VersionPrefix>
    <Description>Package Manager Console commands for packing EF Core migrations: Compress-Migrations and Expand-Migrations. Works with EF Core 6 and later; projects reference the EfMigrationPack runtime package.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="init.ps1;EfMigrationPack.psm1" Pack="true" PackagePath="tools/" />
    <None Include="$(MSBuildThisFileDirectory)../../artifacts/cli-bin/**/*" Pack="true" PackagePath="tools/bin/%(RecursiveDir)" Visible="false" />
  </ItemGroup>

  <Target Name="EfPackCheckCliBinaries" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../artifacts/cli-bin/EfMigrationPack.Cli.dll')"
           Text="Publish the CLI to artifacts/cli-bin first (build.ps1 does this)." />
  </Target>

</Project>
