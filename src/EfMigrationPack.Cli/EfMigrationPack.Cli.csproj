<Project Sdk="Microsoft.NET.Sdk">

  <!--
    dotnet-ef-pack: the command-line tool, invoked as "dotnet ef-pack" (like "dotnet ef").
    It only parses C# source, so one build works for every EF Core version.
    net6.0 + RollForward=Major: runs on any installed .NET 6 or later runtime.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <RollForward>Major</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EfMigrationPack.Cli</AssemblyName>
    <RootNamespace>EfMigrationPack</RootNamespace>
    <!-- Skip Roslyn's translated resource folders; messages stay in English. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-ef-pack</ToolCommandName>
    <PackageId>dotnet-ef-pack</PackageId>
    <VersionPrefix>1.$(PackRelease)</VersionPrefix>
    <Description>Command-line tool for packing EF Core migrations: "dotnet ef-pack compress" packs migrations into one migration and archives the originals in a zip; "dotnet ef-pack expand" restores them. Works with EF Core 6 and later; projects reference the EfMigrationPack runtime package.</Description>
    <PackageTags>$(PackageTags);dotnet-tool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
  </ItemGroup>

</Project>
