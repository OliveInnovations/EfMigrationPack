<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test project for Run-IntegrationTests.ps1. Not built in place: the script copies it to
    artifacts/integration/ef{N}/ and supplies these properties in a generated Directory.Build.props:
      TestTargetFramework  net6.0 / net8.0 / net10.0
      EfCoreVersion        e.g. 8.*  (latest EF Core 8)
      EfPackVersion        the EfMigrationPack version just built
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TestTargetFramework)</TargetFramework>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>TestApp</RootNamespace>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" PrivateAssets="all" />
    <PackageReference Include="EfMigrationPack" Version="$(EfPackVersion)" />
  </ItemGroup>

</Project>
